{
    "name": "aaron-schlossbergs-universe",
    "private": true,
    "scripts": {
        "heads": "node scripts/render-heads.mjs",
        "check:heads": "node scripts/render-heads.mjs --check",
        "test:heads": "node --test scripts/test-heads.mjs",
        "validate": "node scripts/validate-site.mjs",
        "editor": "node authoring/server.mjs",
        "test:editor": "node --test authoring/test.mjs",
        "build": "npm run heads && npm run prepare:fonts && npm run optimize:images && npm run build:site && npm run build:css",
        "optimize:images": "node scripts/optimize-images.mjs",
        "build:site": "node scripts/validate-site.mjs && node scripts/build-site.mjs",
        "build:css": "lightningcss --bundle --minify assets/css/main.css -o _site/assets/css/main.css",
        "prepare:fonts": "node scripts/copy-fonts.mjs"
    },
    "devDependencies": {
        "@fontsource/lora": "^5.3.0",
        "@tiptap/core": "3.32.3",
        "@tiptap/extension-file-handler": "3.32.3",
        "@tiptap/extension-subscript": "3.32.3",
        "@tiptap/extension-superscript": "3.32.3",
        "@tiptap/pm": "3.32.3",
        "@tiptap/starter-kit": "3.32.3",
        "@tiptap/static-renderer": "3.32.3",
        "cheerio": "1.2.0",
        "esbuild": "0.28.2",
        "katex": "0.19.1",
        "lightningcss-cli": "^1.30.1",
        "sharp": "^0.35.4"
    },
    "engines": {
        "node": ">=20.18.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "lightningcss-cli@1.30.1": true
    }
}
